# Copy this file to .env and fill in the two values from YOUR APS app
# (aps.autodesk.com > My Apps). Never commit .env or paste the secret in a chat.
APS_CLIENT_ID=
APS_CLIENT_SECRET=

# Must match a Callback URL on your APS app. Change only if port 8080 is taken.
APS_CALLBACK_URL=http://localhost:8080/callback

# Optional: the project to use when you don't name one (name or id).
ACC_DEFAULT_PROJECT=

# Optional: where reports are saved (default: the output/ folder here).
ACC_REPORTS_DIR=

# Set to true to try everything with the fictional sample project (no sign-in needed).
ACC_SAMPLE_MODE=false
